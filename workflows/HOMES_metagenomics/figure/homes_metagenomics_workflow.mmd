flowchart TD
    A["Metagenomics samplesheet<br/>Illumina or Nanopore FASTQ"] --> B{"--platform"}
    B --> I1["Illumina read QC<br/>length, quality, N50"]
    B --> N1["Nanopore read QC<br/>length, quality, N50"]
    I1 --> I2["Kraken2 taxonomy<br/>optional Bracken abundance"]
    N1 --> N2["Kraken2 taxonomy<br/>optional Bracken abundance"]
    I2 --> O["QC, taxonomy, and<br/>taxonomic abundance tables"]
    N2 --> O

    C["Contigs FASTA<br/>HOMES_assembly or external assembly"] --> F1{"--run_functional_annotation"}
    F1 -->|true| F2["Prodigal<br/>metagenomic gene prediction"]
    F2 --> F3["eggNOG-mapper<br/>COG, GO, EC, KO, pathway, CAZy"]
    F3 --> F4["Minimap2<br/>map sample reads to genes"]
    F4 --> F5["Functional abundance<br/>gene, KO, EC, pathway"]
    F1 -->|false| F6["Functional profiling not run"]

    O --> R["HOMES HTML report"]
    F5 --> R
    R --> Q["qc/"]
    R --> T["taxonomy/"]
    R --> AB["abundance/"]
    R --> FA["functional_annotation/"]
    R --> H["report/"]
