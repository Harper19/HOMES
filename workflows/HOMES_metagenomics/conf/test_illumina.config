/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    HOMES_metagenomics Illumina test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    platform = 'illumina'
    input    = "${projectDir}/assets/samplesheet_illumina.csv"
    download_databases = false
    skip_taxonomy = true
    run_functional_annotation = false
    functional_annotation_container = 'docker.io/library/python:3.11'
    functional_mapping_container = 'docker.io/library/python:3.11'
}
