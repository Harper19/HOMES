/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    HOMES_metagenomics Nanopore test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    platform = 'nanopore'
    input    = "${projectDir}/assets/samplesheet_nanopore.csv"
    download_databases = false
    skip_taxonomy = true
    functional_contigs = "${projectDir}/assets/testdata/functional/META_FUNCTIONAL_CONTIGS_1.fna"
    run_functional_annotation = true
    functional_annotation_tool = 'native'
    functional_mapping_tool = 'native'
    functional_annotation_container = 'docker.io/library/python:3.11'
    functional_mapping_container = 'docker.io/library/python:3.11'
}
